{
  "name": "reps",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src scripts",
    "typecheck": "tsc --noEmit",
    "content:check": "tsx scripts/check-content.ts",
    "db:seed": "tsx src/lib/db/seed.ts",
    "db:reset": "node -e \"for (const f of ['reps.db','reps.db-wal','reps.db-shm']) require('fs').rmSync(f,{force:true})\" && tsx src/lib/db/seed.ts",
    "check": "npm run typecheck && npm run lint && npm run content:check && npm run test",
    "content:stats": "tsx scripts/content-stats.ts",
    "test": "vitest run",
    "e2e": "node scripts/e2e/e2e.mjs && node scripts/e2e/features.mjs && node scripts/e2e/progression.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/commands": "^6.10.2",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/language": "^6.12.1",
    "@codemirror/state": "^6.5.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.39.14",
    "better-sqlite3": "^12.6.2",
    "drizzle-orm": "^0.45.1",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "ts-fsrs": "^5.2.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "description": "Spaced-repetition interview drills for full-stack developers: JS, TS, React, Node, C#, .NET, SQL and the web."
}
